# ---------------------------------------------------------------------------
# Públicas (vão para o navegador)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (ou a antiga anon key — use NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Somente servidor — NUNCA prefixe com NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# "Secret key" do Supabase (ou a antiga service_role — use SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=

# Provedor de IA (camada trocável). Hoje: anthropic.
# Provedor de IA: anthropic (pago) | gemini (camada gratuita do Google AI Studio) | groq | openrouter | openai_compat
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opções gratuitas (use só a do provedor escolhido)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# openai_compat (ex.: Ollama local): AI_BASE_URL=http://localhost:11434/v1 e, se exigir, AI_API_KEY
AI_BASE_URL=
AI_API_KEY=
# Modelos que "pensam" (Gemini): low economiza cota. Deixe vazio se o modelo não aceitar.
AI_REASONING_EFFORT=
# schema (padrão) ou object, para modelos que não aceitam JSON Schema
AI_JSON_MODE=
# ID do modelo, conforme a documentação do provedor (ex.: claude-sonnet-5-5)
AI_MODEL=
# Preço em USD por milhão de tokens, para estimar custo. Vazio = custo registrado como desconhecido.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# ---------------------------------------------------------------------------
# Testes
# ---------------------------------------------------------------------------
# Postgres onde o usuário pode criar bancos (testes de RLS e persistência)
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres?host=/tmp
# Conta de teste num Supabase de homologação (E2E autenticado)
E2E_EMAIL=
E2E_PASSWORD=
# Chromium já instalado (opcional)
PW_CHROMIUM_PATH=
